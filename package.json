{
  "name": "simple-nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "nuxt typecheck --checker golar",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:nuxt": "vitest run --project nuxt --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.11",
    "@iconify-json/material-symbols": "^1.2.95",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "golar": "^0.1.11",
    "happy-dom": "^21.0.3",
    "nuxt": "^4.6.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
